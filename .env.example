# Copy to .env (gitignored). Never commit real keys.
APERTURE_PROVIDER=minimax
MINIMAX_API_KEY=
MISTRAL_API_KEY=
# Overrides are per provider, never global — a single base-url override applied across
# providers sends one provider's key to another's endpoint.
# MINIMAX_MODEL=MiniMax-M3
# MISTRAL_MODEL=glm-5-2
# MINIMAX_BASE_URL=
# MISTRAL_BASE_URL=
# APERTURE_REASONING=high      # low | medium | high | off
# APERTURE_PIN=
# APERTURE_DATA_DIR=./data
